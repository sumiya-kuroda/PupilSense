import os
from pathlib import Path

# ------------------------------------------------------------------
# REQUIRED ENVIRONMENT VARIABLES
# ------------------------------------------------------------------
INPUT_LIST      = os.environ["INPUT_LIST"]
LOG_DIR         = os.environ["LOG_DIR"]
DEST_CEPH       = os.environ["DEST_CEPH"]
PUPILSENSE_PATH = os.environ["PUPILSENSE_PATH"]

# ------------------------------------------------------------------
# Helper to read input list
# ------------------------------------------------------------------
def read_input_list(path):
    with open(path) as f:
        return [line.strip() for line in f if line.strip()]

# Input videos (avi or mp4)
video_files = [
    p for p in read_input_list(INPUT_LIST)
]

# Final expected output directories
ids = []
id_to_video = {}
for i, v in enumerate(video_files):
    stem = Path(v).stem
    vid_id = f"{i:04d}_{stem}"
    ids.append(vid_id)
    id_to_video[vid_id] = v

# Our Snakemake targets: one log directory per video
logdirs = [
    f"{LOG_DIR}/{vid_id}_logs"
    for vid_id in ids
]

# ------------------------------------------------------------------
# TOP-LEVEL
# ------------------------------------------------------------------
rule all:
    input:
        logdirs

# ------------------------------------------------------------------
# MAIN RULE — extracts frames and writes timestamped logs
# ------------------------------------------------------------------
rule extract_frames:
    """
    For each video:
      - Convert AVI → MP4 if needed (same filename, .mp4)
      - Run pupilsense.extract_frames
      - Write timestamped log to {video}_logs/
    """
    input:
        video=lambda wc: id_to_video[wc.id]
    output:
        logdir=directory(LOG_DIR + "/{id}_logs")
    wildcard_constraints:
        id=r".+"
    params:
        dest=DEST_CEPH,
        pupilsense_path=PUPILSENSE_PATH
    threads: 4
    run:
        import sys
        import os
        import subprocess
        from datetime import datetime
        from pathlib import Path

        video_path = Path(str(input.video))
        outdir     = Path(str(output.logdir))

        # Ensure directories exist
        os.makedirs(outdir, exist_ok=True)
        os.makedirs(params.dest, exist_ok=True)

        # Make pupilsense importable
        sys.path.append(params.pupilsense_path)
        from pupilsense.extract_frames import main

        # Determine MP4 path
        if video_path.suffix.lower() == ".mp4":
            mp4_path = video_path
        else:
            mp4_path = video_path.with_suffix(".mp4")
            subprocess.run(
                [
                    "ffmpeg",
                    "-i", str(video_path),
                    "-y",
                    "-c:v", "libx264",
                    "-crf", "20",
                    "-preset", "medium",
                    str(mp4_path),
                    "-hide_banner",
                    "-loglevel", "error",
                ],
                check=True
            )

        # Create timestamped log file inside the logdir
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        ts_log = outdir / f"{video_path.stem}_{timestamp}.log"

        print(f"[extract_frames] Writing {ts_log}")

        # Run pupilsense
        main(
            input_file_location=str(mp4_path),
            log=str(ts_log),
            output=params.dest,
        )